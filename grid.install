<?php

function grid_schema()
{
    $core = grid_get_core();
    $schema = $core->getDatabaseSchema();
    $schema['grid_nodes']=array(
        'description'=>t('references nodes'),
        'fields'=>array(
            'nid'=>array(
                'description'=>t('node id'),
                'type' => 'int',
                'unsigned'=>true,
                'not null'=>true,
            ),
            'grid_id'=>array(
                'description'=>t('grid id'),
                'type'=>'int',
                'size'=>'normal',
                'unsigned'=>true,
                'not null'=>true,
            ),
            'langcode'=>array(
                'description'=>t('language'),
                'type'=>'varchar',
                'length'=>12,
		'not null'=>true,
            ),
        ),
        'primary key'=>array('nid','langcode'),
        'mysql_engine'=>'InnoDB',
    );
    $schema[\Drupal\grid\TwoClick\Constants\Constants::TWO_CLICK_DB_TABLE] = Drupal\grid\TwoClick\Constants\Constants::TWO_CLICK_DB_TABLE_SCHEMA;
    return $schema;
}

function grid_install()
{
  grid_get_core()->install();
}

function grid_uninstall()
{
  grid_get_core()->uninstall();
}

/**
 * Implements hook_update_last_removed().
 *
 * The updates of the 8.x-1.x line used database functions Drupal 9 removed.
 * Sites still before them update to a 2.x release of the module first.
 */
function grid_update_last_removed()
{
  return 8104;
}

function grid_update_8201($sandbox)
{
  grid_get_core()->update();
}

function grid_update_8202( $sandbox )
{

  $tableName = \Drupal\grid\TwoClick\Constants\Constants::TWO_CLICK_DB_TABLE;
  $tableSchema = Drupal\grid\TwoClick\Constants\Constants::TWO_CLICK_DB_TABLE_SCHEMA;
  $database = \Drupal::database();
  $schema   = $database->schema();

  if (!$schema->tableExists($tableName)){
    $schema->createTable( $tableName, $tableSchema );
  }

}


function grid_update_91001( $sandbox )
{
  $tableName = \Drupal\grid\TwoClick\Constants\Constants::TWO_CLICK_DB_TABLE;
  $database = \Drupal::database();

  $field = [
    'type' => 'int',
    'not null' => TRUE,
    'default' => 0,
    'size' => 'big',
  ];
  $schema = $database->schema();
  // installs since this update get the column from the table's schema
  if (!$schema->fieldExists($tableName, 'last_updated')) {
    $schema->addField($tableName, 'last_updated', $field);
  }
}

/**
 * Grid library 3.0: a change counter on grids (schema update 8), duplicate links
 * between grids, containers, slots and boxes removed and unique keys added
 * (schema update 9).
 */
function grid_update_91002($sandbox)
{
  grid_get_core()->update();
}

/**
 * Implements hook_requirements().
 */
function grid_requirements($phase)
{
  $requirements = [];
  if ($phase !== 'runtime') {
    return $requirements;
  }
  $path = \Drupal::service('library.libraries_directory_file_finder')->find('grid');
  $built = $path && file_exists(DRUPAL_ROOT . '/' . $path . '/js/dist/grid-editor.js');
  $requirements['grid_library'] = [
    'title' => t('Grid library'),
    'value' => $path ?: t('Missing'),
    'severity' => $built ? REQUIREMENT_OK : REQUIREMENT_ERROR,
  ];
  if (!$path) {
    $requirements['grid_library']['description'] = t('Require palasthotel/grid with Composer; it installs to the libraries directory.');
  }
  elseif (!$built) {
    $requirements['grid_library']['description'] = t('The grid editor is not built yet. Run npm ci && npm run build in @path.', ['@path' => $path]);
  }
  return $requirements;
}
